COMPOSE_PROJECT_NAME=vedicway
RELEASE_TAG=replace-with-immutable-release-tag
BACKEND_IMAGE=vedicway-backend
FRONTEND_IMAGE=vedicway-frontend

# Публичный порт слушает только loopback. Перед ним обязателен TLS reverse proxy.
PUBLIC_HTTP_BIND=127.0.0.1
PUBLIC_HTTP_PORT=8080
VEDICWAY_PUBLIC_BASE_URL=https://vedicway.example
VEDICWAY_PUBLIC_ORIGIN=https://vedicway.example
VEDICWAY_RUNTIME_PROFILE=single-node-sqlite

# SEO-agent is an optional Compose profile. Keep it disabled until all VedicWay-only
# Yandex credentials and exact resource identifiers pass scripts/check_seo_agent_release.py.
VEDICWAY_SEO_AGENT_ENABLED=0
VEDICWAY_SEO_AGENT_BASE_URL=http://backend:8000
VEDICWAY_SEO_DB=/var/lib/vedicway/seo-agent/vedicway_seo_agent.sqlite3
VEDICWAY_SEO_MIN_ARTICLE_CHARS=4500
VEDICWAY_SEO_JOB_TIMEOUT_SECONDS=3600
VEDICWAY_DZEN_PUBLICATION_MODE=native-draft
VEDICWAY_YANDEX_HOST_ID=REPLACE_WITH_EXACT_VEDICWAY_WEBMASTER_HOST_ID
VEDICWAY_METRIKA_COUNTER_ID=REPLACE_WITH_EXACT_VEDICWAY_COUNTER_ID

# Реальные реквизиты оператора. Заглушки блокируют release preflight и readiness.
VEDICWAY_LEGAL_OPERATOR_NAME=REPLACE_WITH_LEGAL_OPERATOR_NAME
VEDICWAY_LEGAL_OPERATOR_ADDRESS=REPLACE_WITH_LEGAL_OPERATOR_ADDRESS
VEDICWAY_LEGAL_OPERATOR_INN=REPLACE_WITH_INN
VEDICWAY_LEGAL_OPERATOR_OGRN=REPLACE_WITH_OGRN_OR_OGRNIP
VEDICWAY_PRIVACY_EMAIL=REPLACE_WITH_PRIVACY_EMAIL

# Числовой ID счётчика. Он встраивается в frontend только во время сборки.
VITE_YANDEX_METRIKA_ID=REPLACE_WITH_YANDEX_METRIKA_ID

POSTGRES_DB=vedicway
POSTGRES_USER=vedicway
VEDICWAY_DOCKER_SUBNET=172.29.0.0/24
VEDICWAY_TRUSTED_PROXY_CIDRS=172.29.0.0/24,172.30.0.0/28
VEDICWAY_OPERATIONS_CIDRS=REPLACE_WITH_SUPPORT_VPN_CIDR

# Файл с лицензированным мировым справочником мест рождения.
VEDICWAY_PLACE_DATASET_FILE=./runtime/places.json

# Linux wheelhouse pyjhora-mcp 0.1.0 со всеми зависимостями и SHA256SUMS.
PYJHORA_WHEELHOUSE_DIR=./runtime/pyjhora-wheelhouse
CODEX_CLI_VERSION=0.144.6

VEDICWAY_INTERPRETATION_PROVIDER=codex
# Договорные реквизиты фактического внешнего обработчика персонализированных объяснений.
# DATA_CATEGORIES перечисляются через |. CROSS_BORDER: 1, если передача идёт за пределы РФ, иначе 0.
VEDICWAY_INTERPRETATION_PROCESSOR_NAME=REPLACE_WITH_PROCESSOR_LEGAL_NAME
VEDICWAY_INTERPRETATION_PROCESSOR_ADDRESS=REPLACE_WITH_PROCESSOR_LEGAL_ADDRESS
VEDICWAY_INTERPRETATION_PROCESSOR_COUNTRY=REPLACE_WITH_PROCESSOR_COUNTRY
VEDICWAY_INTERPRETATION_PROCESSOR_PURPOSE=REPLACE_WITH_PROCESSING_PURPOSE
VEDICWAY_INTERPRETATION_PROCESSOR_DATA_CATEGORIES=REPLACE_WITH_CATEGORY_ONE|REPLACE_WITH_CATEGORY_TWO
VEDICWAY_INTERPRETATION_PROCESSOR_CROSS_BORDER=REPLACE_WITH_0_OR_1
VEDICWAY_CODEX_FREE_MODEL=gpt-5.6-luna
VEDICWAY_CODEX_PAID_MODEL=gpt-5.6-terra
VEDICWAY_CODEX_FREE_REASONING=low
VEDICWAY_CODEX_PAID_REASONING=medium
VEDICWAY_CODEX_SERVICE_TIER=fast
VEDICWAY_CODEX_FREE_TIMEOUT_SECONDS=35
VEDICWAY_CODEX_PAID_TIMEOUT_SECONDS=120

VEDICWAY_PAYMENT_PROVIDER=yookassa
VEDICWAY_TEST_PAYMENTS=0
VEDICWAY_OFFER_VERSION=REPLACE_WITH_PUBLISHED_OFFER_VERSION
VEDICWAY_OFFER_URL=https://vedicway.example/legal/user-agreement
VEDICWAY_PRIVACY_URL=https://vedicway.example/legal/privacy-policy
YOOKASSA_VAT_CODE=REPLACE_WITH_CONFIRMED_VAT_CODE
# YOOKASSA_TAX_SYSTEM_CODE=REPLACE_IF_REQUIRED
YOOKASSA_PAYMENT_DESCRIPTION=Оплата полного отчёта VedicWay

# Транзакционные письма: готовый отчёт и одноразовое восстановление доступа.
VEDICWAY_SMTP_HOST=smtp.example
VEDICWAY_SMTP_PORT=587
VEDICWAY_SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
VEDICWAY_SMTP_FROM_EMAIL=no-reply@vedicway.example
VEDICWAY_SMTP_FROM_NAME=VedicWay
VEDICWAY_SMTP_STARTTLS=1
VEDICWAY_SMTP_SSL=0
VEDICWAY_SMTP_TIMEOUT_SECONDS=10

# Все сроки утверждает оператор до релиза. Значения ниже служат только примером формата.
VEDICWAY_RETENTION_ANONYMOUS_CHART_DAYS=REPLACE_WITH_APPROVED_DAYS
VEDICWAY_RETENTION_REPORT_DAYS=REPLACE_WITH_APPROVED_DAYS
VEDICWAY_RETENTION_SECURITY_LOG_DAYS=REPLACE_WITH_APPROVED_DAYS
VEDICWAY_RETENTION_FINANCIAL_RECORD_DAYS=REPLACE_WITH_APPROVED_DAYS
VEDICWAY_RETENTION_BACKUP_DAYS=REPLACE_WITH_APPROVED_DAYS

# Пути к secret-файлам. В файлах хранится только значение без имени переменной.
POSTGRES_PASSWORD_FILE=./secrets/postgres_password.txt
VEDICWAY_DATA_KEY_FILE=./secrets/vedicway_data_key.txt
VEDICWAY_SIGNING_KEY_FILE=./secrets/vedicway_signing_key.txt
VEDICWAY_OPERATIONS_TOKEN_FILE=./secrets/vedicway_operations_token.txt
VEDICWAY_METRICS_TOKEN_FILE=./secrets/vedicway_metrics_token.txt
VEDICWAY_SEO_AGENT_TOKEN_FILE=./secrets/vedicway_seo_agent_token.txt
VEDICWAY_YANDEX_SEARCH_API_KEY_FILE=./secrets/vedicway_yandex_search_api_key.txt
VEDICWAY_YANDEX_FOLDER_ID_FILE=./secrets/vedicway_yandex_folder_id.txt
VEDICWAY_YANDEX_WEBMASTER_TOKEN_FILE=./secrets/vedicway_yandex_webmaster_token.txt
VEDICWAY_YANDEX_METRIKA_TOKEN_FILE=./secrets/vedicway_yandex_metrika_token.txt
YOOKASSA_SHOP_ID_FILE=./secrets/yookassa_shop_id.txt
YOOKASSA_SECRET_KEY_FILE=./secrets/yookassa_secret_key.txt
OPENAI_API_KEY_FILE=./secrets/codex_api_key.txt
VEDICWAY_SMTP_PASSWORD_FILE=./secrets/smtp_password.txt
VEDICWAY_BACKUP_KEY_FILE=./secrets/backup_encryption_key.txt
