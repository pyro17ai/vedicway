{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vedicway.ru/contracts/content-article-manifest-v2.json",
  "title": "VedicWay Codex Markdown article manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "draft_id", "claim_token", "content_hash", "article", "media"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "draft_id": {"type": "string", "minLength": 1},
    "claim_token": {"type": "string", "minLength": 20},
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "article": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section", "difficulty", "title", "slug", "category", "excerpt",
        "content_markdown", "seo_title", "meta_description", "focus_keyphrase",
        "tags", "schema_extra", "author_name", "cover_image_alt"
      ],
      "properties": {
        "section": {"const": "blog"},
        "difficulty": {"enum": ["beginner", "expert"]},
        "title": {"type": "string", "minLength": 35, "maxLength": 100},
        "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 120},
        "category": {"type": "string", "minLength": 1, "maxLength": 120},
        "excerpt": {"type": "string", "minLength": 80, "maxLength": 300},
        "content_markdown": {"type": "string", "minLength": 4500, "maxLength": 300000},
        "cover_media_id": {"type": ["string", "null"]},
        "cover_image_url": {"type": ["string", "null"]},
        "cover_image_alt": {"type": "string", "minLength": 1, "maxLength": 300},
        "seo_title": {"type": "string", "minLength": 30, "maxLength": 80},
        "meta_description": {"type": "string", "minLength": 80, "maxLength": 200},
        "focus_keyphrase": {"type": "string", "minLength": 1, "maxLength": 180},
        "tags": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 80}
        },
        "schema_extra": {"type": "object"},
        "author_name": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    },
    "media": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["local_path", "purpose", "alt_text", "source_kind", "license_note"],
        "properties": {
          "local_path": {"type": "string", "minLength": 1},
          "purpose": {"enum": ["cover", "body"]},
          "placeholder": {"type": "string", "pattern": "^\\{\\{media:body-[1-9][0-9]*\\}\\}$"},
          "alt_text": {"type": "string", "minLength": 1, "maxLength": 300},
          "title": {"type": "string", "maxLength": 240},
          "caption": {"type": "string", "maxLength": 500},
          "source_kind": {"enum": ["generated", "licensed", "owned"]},
          "source_url": {"type": ["string", "null"], "format": "uri"},
          "license_note": {"type": "string", "minLength": 1},
          "distribution_role": {"enum": ["pinterest"]}
        }
      }
    }
  }
}
