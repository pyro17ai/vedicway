{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vedicway.ru/contracts/seo-article-manifest-v1.json",
  "title": "VedicWay SEO article manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "draft_id", "claim_token", "content_hash", "article", "media"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "draft_id": {"type": "string", "minLength": 1},
    "claim_token": {"type": "string", "minLength": 20},
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "article": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title", "slug", "category", "excerpt", "content", "seo_title",
        "meta_description", "focus_keyphrase", "canonical_url", "author_name", "status"
      ],
      "properties": {
        "title": {"type": "string", "minLength": 35, "maxLength": 100},
        "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 120},
        "category": {"type": "string", "minLength": 1, "maxLength": 120},
        "excerpt": {"type": "string", "minLength": 80, "maxLength": 300},
        "content": {"type": "string", "minLength": 4500, "maxLength": 30000},
        "cover_media_id": {"type": ["string", "null"]},
        "body_media_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "cover_image_url": {"type": ["string", "null"]},
        "cover_image_alt": {"type": "string", "maxLength": 300},
        "seo_title": {"type": "string", "minLength": 30, "maxLength": 80},
        "meta_description": {"type": "string", "minLength": 80, "maxLength": 200},
        "focus_keyphrase": {"type": "string", "minLength": 1, "maxLength": 180},
        "canonical_url": {"type": "string", "format": "uri", "pattern": "^https://vedicway\\.ru/guide/"},
        "author_name": {"type": "string", "minLength": 1, "maxLength": 160},
        "status": {"const": "published"}
      }
    },
    "media": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["local_path", "purpose", "alt_text", "source_kind", "license_note"],
        "properties": {
          "local_path": {"type": "string", "minLength": 1},
          "purpose": {"enum": ["cover", "body"]},
          "placeholder": {"type": "string", "pattern": "^\\{\\{media:body-[1-9][0-9]*\\}\\}$"},
          "alt_text": {"type": "string", "minLength": 1, "maxLength": 300},
          "title": {"type": "string", "maxLength": 240},
          "caption": {"type": "string", "maxLength": 500},
          "source_kind": {"enum": ["generated", "licensed", "owned"]},
          "source_url": {"type": ["string", "null"], "format": "uri"},
          "license_note": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
