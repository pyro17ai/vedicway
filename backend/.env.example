VEDICWAY_ENV=development
VEDICWAY_DATA_DIR=D:\CODEX_WORK\VedicWay\backend\.data
# Production compose separates API and worker. Development keeps inline worker on.
# VEDICWAY_INLINE_WORKER=0
# Temporary production topology: PostgreSQL for admin/content, SQLite for charts/payments.
# VEDICWAY_STORAGE_MODE=split
# DATABASE_URL=postgresql+psycopg://vedicway:CHANGE_ME@127.0.0.1:5432/vedicway
# Production admin/content storage. Use a managed PostgreSQL cluster in Russia.
# VEDICWAY_DATABASE_URL=postgresql+psycopg://vedicway:CHANGE_ME@127.0.0.1:5432/vedicway
# Production currently supports one API/worker instance for the legacy chart runtime store.
# VEDICWAY_RUNTIME_PROFILE=single-node-sqlite
# VEDICWAY_MEDIA_DIR=D:\secure-data\vedicway-media
# VEDICWAY_PUBLIC_ORIGIN=https://vedicway.ru
# VEDICWAY_LEGAL_OPERATOR_NAME=
# VEDICWAY_LEGAL_OPERATOR_ADDRESS=
# VEDICWAY_LEGAL_OPERATOR_INN=
# VEDICWAY_LEGAL_OPERATOR_OGRN=
# VEDICWAY_PRIVACY_EMAIL=
# One-time bootstrap. Remove both variables and restart after the first login.
# VEDICWAY_BOOTSTRAP_ADMIN_EMAIL=
# VEDICWAY_BOOTSTRAP_ADMIN_PASSWORD=
# VEDICWAY_BOOTSTRAP_ADMIN_NAME=Администратор
# Локальный симулятор redirect. В production значение обязано быть 0.
VEDICWAY_TEST_PAYMENTS=1
VEDICWAY_PAYMENT_PROVIDER=disabled
VEDICWAY_PYJHORA_SOURCE=C:\Users\Grisha\Documents\Codex\2026-07-08\pyjhora-mcp\src
# Optional backend registry with place_id, display_name, country_code,
# latitude, longitude, tzid and alternate_names. Worldwide browser search uses Open-Meteo.
# VEDICWAY_PLACE_DATASET_PATH=D:\secure-data\vedicway-places.json
# Production: URL-safe Fernet key. It is required when VEDICWAY_ENV=production.
# VEDICWAY_DATA_KEY=
# Production: independent random secret of at least 32 bytes for signed links.
# VEDICWAY_SIGNING_KEY=
# Optional independent HMAC pepper for IP and consent fingerprints. If omitted,
# VEDICWAY_SIGNING_KEY is used. Keep it stable and at least 32 bytes in production.
# VEDICWAY_PRIVACY_PEPPER=
# VEDICWAY_METRICS_TOKEN=
# Транзакционные письма: доступ к купленному разбору и восстановление ссылки.
# В production readiness остаётся красным, пока SMTP не задан полностью.
# VEDICWAY_SMTP_HOST=smtp.example.ru
# VEDICWAY_SMTP_PORT=587
# VEDICWAY_SMTP_USERNAME=
# VEDICWAY_SMTP_PASSWORD=
# VEDICWAY_SMTP_FROM_EMAIL=no-reply@vedicway.ru
# VEDICWAY_SMTP_FROM_NAME=VedicWay
# VEDICWAY_SMTP_STARTTLS=1
# VEDICWAY_SMTP_SSL=0
# VEDICWAY_SMTP_TIMEOUT_SECONDS=10
# Сроки утверждает оператор после юридической проверки. Production требует все пять значений.
# VEDICWAY_RETENTION_ANONYMOUS_CHART_DAYS=30
# VEDICWAY_RETENTION_REPORT_DAYS=30
# VEDICWAY_RETENTION_SECURITY_LOG_DAYS=
# VEDICWAY_RETENTION_FINANCIAL_RECORD_DAYS=
# VEDICWAY_RETENTION_BACKUP_DAYS=
# Персональные тексты не имеют неявного шаблонного fallback. Для рабочего
# контура укажите codex; stub разрешён только в контрактных тестах.
VEDICWAY_INTERPRETATION_PROVIDER=codex
# Отдельный CODEX_HOME содержит только auth.json этого runner. Пользовательский
# ~/.codex и рабочая репа сервису недоступны.
# VEDICWAY_CODEX_HOME=C:\runtime\vedicway-codex-home
# VEDICWAY_AGENT_WORKDIR=C:\runtime\vedicway-empty-workdir
# VEDICWAY_CODEX_EXECUTABLE=C:\path\to\codex.exe
VEDICWAY_CODEX_FREE_MODEL=gpt-5.6-luna
VEDICWAY_CODEX_PAID_MODEL=gpt-5.6-terra
VEDICWAY_CODEX_FREE_REASONING=low
VEDICWAY_CODEX_PAID_REASONING=medium
VEDICWAY_CODEX_SERVICE_TIER=fast
VEDICWAY_CODEX_FREE_TIMEOUT_SECONDS=35
VEDICWAY_CODEX_PAID_TIMEOUT_SECONDS=120

# YooKassa production settings. Do not commit real values.
# VEDICWAY_PAYMENT_PROVIDER=yookassa
# Публичный origin без завершающего слеша. В production принимается только HTTPS.
# VEDICWAY_PUBLIC_BASE_URL=https://vedicway.ru
# Версия должна совпадать с опубликованным текстом оферты.
# VEDICWAY_OFFER_VERSION=2026-07-19
# VEDICWAY_OFFER_URL=https://vedicway.ru/legal/user-agreement
# VEDICWAY_PRIVACY_URL=https://vedicway.ru/legal/privacy-policy
# Случайный токен от 32 символов для /internal/payments/*. Не использовать в browser.
# VEDICWAY_OPERATIONS_TOKEN=
# Сети reverse proxy, которым разрешено передавать X-Forwarded-For.
# VEDICWAY_TRUSTED_PROXY_CIDRS=10.0.0.0/8
# Сети support/VPN, из которых доступны reconcile и refund.
# VEDICWAY_OPERATIONS_CIDRS=10.10.0.0/16
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# Код НДС по контракту YooKassa: 1..12. Значение подтверждает владелец магазина.
# YOOKASSA_VAT_CODE=1
# Необязательная система налогообложения: 1..6, если её требует конфигурация магазина.
# YOOKASSA_TAX_SYSTEM_CODE=
# YOOKASSA_PAYMENT_DESCRIPTION=Оплата полного отчёта VedicWay
# Только для локального MockTransport. Production запрещает менять официальный API origin.
# YOOKASSA_API_BASE_URL=https://api.yookassa.ru/v3
