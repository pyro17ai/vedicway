VEDICWAY_ENV=development
VEDICWAY_DATA_DIR=D:\CODEX_WORK\VedicWay\backend\.data
# Локальный симулятор redirect. В production значение обязано быть 0.
VEDICWAY_TEST_PAYMENTS=1
VEDICWAY_PAYMENT_PROVIDER=disabled
VEDICWAY_PYJHORA_SOURCE=C:\Users\Grisha\Documents\Codex\2026-07-08\pyjhora-mcp\src
# Production: licensed JSON registry with place_id, display_name, country_code,
# latitude, longitude, tzid and optional alternate_names. No public geocoder is used.
# VEDICWAY_PLACE_DATASET_PATH=D:\secure-data\vedicway-places.json
# Production: URL-safe Fernet key. It is required when VEDICWAY_ENV=production.
# VEDICWAY_DATA_KEY=
# Production: independent random secret of at least 32 bytes for signed links.
# VEDICWAY_SIGNING_KEY=
# VEDICWAY_METRICS_TOKEN=
# VEDICWAY_CODEX_HOME=
# VEDICWAY_AGENT_WORKDIR=/srv/vedicway/empty-workdir
# VEDICWAY_INTERPRETATION_PROVIDER=codex

# YooKassa production settings. Do not commit real values.
# VEDICWAY_PAYMENT_PROVIDER=yookassa
# Публичный origin без завершающего слеша. В production принимается только HTTPS.
# VEDICWAY_PUBLIC_BASE_URL=https://vedicway.example
# Версия должна совпадать с опубликованным текстом оферты.
# VEDICWAY_OFFER_VERSION=2026-07-18
# VEDICWAY_OFFER_URL=https://vedicway.example/legal/offer
# VEDICWAY_PRIVACY_URL=https://vedicway.example/legal/privacy
# Случайный токен от 32 символов для /internal/payments/*. Не использовать в browser.
# VEDICWAY_OPERATIONS_TOKEN=
# Сети reverse proxy, которым разрешено передавать X-Forwarded-For.
# VEDICWAY_TRUSTED_PROXY_CIDRS=10.0.0.0/8
# Сети support/VPN, из которых доступны reconcile и refund.
# VEDICWAY_OPERATIONS_CIDRS=10.10.0.0/16
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# Код НДС по контракту YooKassa: 1..12. Значение подтверждает владелец магазина.
# YOOKASSA_VAT_CODE=1
# Необязательная система налогообложения: 1..6, если её требует конфигурация магазина.
# YOOKASSA_TAX_SYSTEM_CODE=
# YOOKASSA_PAYMENT_DESCRIPTION=Оплата полного отчёта VedicWay
# Только для локального MockTransport. Production запрещает менять официальный API origin.
# YOOKASSA_API_BASE_URL=https://api.yookassa.ru/v3
