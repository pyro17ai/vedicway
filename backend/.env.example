VEDICWAY_ENV=development
VEDICWAY_DATA_DIR=D:\CODEX_WORK\VedicWay\backend\.data
VEDICWAY_TEST_PAYMENTS=1
VEDICWAY_PYJHORA_SOURCE=C:\Users\Grisha\Documents\Codex\2026-07-08\pyjhora-mcp\src
# Production: licensed JSON registry with place_id, display_name, country_code,
# latitude, longitude, tzid and optional alternate_names. No public geocoder is used.
# VEDICWAY_PLACE_DATASET_PATH=D:\secure-data\vedicway-places.json
# Production: URL-safe Fernet key. It is required when VEDICWAY_ENV=production.
# VEDICWAY_DATA_KEY=
# VEDICWAY_SIGNING_KEY=
# VEDICWAY_PAYMENT_WEBHOOK_SECRET=
# VEDICWAY_METRICS_TOKEN=
# Персональные тексты не имеют неявного шаблонного fallback. Для рабочего
# контура укажите codex; stub разрешён только в контрактных тестах.
VEDICWAY_INTERPRETATION_PROVIDER=codex
# Отдельный CODEX_HOME содержит только auth.json этого runner. Пользовательский
# ~/.codex и рабочая репа сервису недоступны.
# VEDICWAY_CODEX_HOME=C:\runtime\vedicway-codex-home
# VEDICWAY_AGENT_WORKDIR=C:\runtime\vedicway-empty-workdir
# VEDICWAY_CODEX_EXECUTABLE=C:\path\to\codex.exe
VEDICWAY_CODEX_FREE_MODEL=gpt-5.6-luna
VEDICWAY_CODEX_PAID_MODEL=gpt-5.6-terra
VEDICWAY_CODEX_FREE_REASONING=low
VEDICWAY_CODEX_PAID_REASONING=medium
VEDICWAY_CODEX_SERVICE_TIER=fast
VEDICWAY_CODEX_FREE_TIMEOUT_SECONDS=35
VEDICWAY_CODEX_PAID_TIMEOUT_SECONDS=120
